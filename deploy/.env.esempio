# Indirizzo pubblico della piattaforma (sottodominio che punta al server)
DOMINIO=voto.tuascuola.edu.it

# Primo amministratore (dirigente o segreteria)
ADMIN_EMAIL=dirigente@tuascuola.edu.it
ADMIN_NOME=Nome
ADMIN_COGNOME=Cognome

# Invio dei codici di accesso. Esempio con una casella Aruba:
# SMTP_URL=smtps://noreply%40tuascuola.edu.it:PASSWORD@smtps.aruba.it:465
# (la @ dell'utente va scritta %40)
SMTP_URL=
SMTP_FROM="Votazioni <noreply@tuascuola.edu.it>"
