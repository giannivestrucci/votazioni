{
  "name": "votazioni",
  "version": "1.0.0",
  "description": "Piattaforma di voto online per le istituzioni scolastiche: sedute degli organi collegiali (nota MIM prot. 3803 del 30/06/2026 e relativo Allegato tecnico) ed elezioni dei rappresentanti (O.M. 215/1991).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giannivestrucci/votazioni.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/giannivestrucci/votazioni/issues"
  },
  "homepage": "https://github.com/giannivestrucci/votazioni#readme",
  "dependencies": {
    "@cloudflare/blindrsa-ts": "^0.4.4",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
